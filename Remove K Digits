class Solution {
public:
    string removeKdigits(string num, int k) {

        // Store digits in increasing order
        stack<char> st;

        int n = num.size();

        // Traverse each digit of the number
        for (int i = 0; i < n; i++) {

            // If current digit is smaller than stack top,
            // removing the larger digit will make the number smaller.
            while (!st.empty() &&
                   k > 0 &&
                   (st.top() - '0') > (num[i] - '0')) {

                st.pop();  // Remove larger digit
                k--;       // One deletion used
            }

            // Push current digit into stack
            st.push(num[i]);
        }

        // If deletions are still left,
        // remove digits from the end (largest place value remaining)
        while (k > 0) {
            st.pop();
            k--;
        }

        // If all digits were removed
        if (st.empty())
            return "0";

        string res = "";

        // Stack stores digits in reverse order,
        // so extract all digits
        while (!st.empty()) {
            res = res + st.top();
            st.pop();
        }

        // Reverse to get original order
        reverse(res.begin(), res.end());

        // Remove leading zeros
        int i = 0;
        while (i < res.size() && res[i] == '0') {
            i++;
        }

        // Keep only the part after leading zeros
        res = res.substr(i);

        // If result becomes empty, return 0
        if (res.empty())
            return "0";

        return res;
    }
};
