class Solution {
public:
    // Function to merge two halves of the array
    void merge(vector<int>& arr, int low, int mid, int high) {
        // Temporary vector to hold merged values
        vector<int> temp;
        int left = low;      // Starting index of left subarray
        int right = mid + 1; // Starting index of right subarray

        // Merge the two halves while comparing elements
        while (left <= mid && right <= high) {
            if (arr[left] <= arr[right]) {
                // If left element is smaller, add it to temp
                temp.push_back(arr[left]);
                left++; // Move to the next element in the left subarray
            } else {
                // If right element is smaller, add it to temp
                temp.push_back(arr[right]);
                right++; // Move to the next element in the right subarray
            }
        }

        // Add remaining elements from the left subarray, if any
        while (left <= mid) {
            temp.push_back(arr[left]);
            left++;
        }

        // Add remaining elements from the right subarray, if any
        while (right <= high) {
            temp.push_back(arr[right]);
            right++;
        }

        // Copy the merged elements back into the original array
        for (int i = low; i <= high; i++) {
            arr[i] = temp[i - low];
        }
    }

    // Recursive function to perform merge sort
    void mS(vector<int>& arr, int low, int high) {
        if (low >= high) // Base case: if the subarray has one or no elements
            return;

        int mid = (low + high) / 2; // Find the middle index
        // Recursively sort the left half
        mS(arr, low, mid);
        // Recursively sort the right half
        mS(arr, mid + 1, high);
        // Merge the two sorted halves
        merge(arr, low, mid, high);
    }

    // Function to initiate merge sort
    void mergeSort(vector<int>& arr, int n) {
        mS(arr, 0, n - 1); // Start the recursive sorting process
    }

    // Function to sort an array and return it
    vector<int> sortArray(vector<int>& nums) {
        mergeSort(nums, nums.size()); // Call mergeSort on the input array
        return nums; // Return the sorted array
    }
};
