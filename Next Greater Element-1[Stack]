class Solution {
public:
    // Function to find the next greater element for each element in nums1
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        // Stack to keep track of elements for which we need to find the next greater element
        stack<int> st;
        
        // Map to store the next greater element for each element in nums2
        unordered_map<int,int> list;

        // Iterate through nums2 in reverse order
        for(int i = nums2.size() - 1; i >= 0; i--) {
            // While the stack is not empty and the top element of the stack is less than or equal to the current element
            while(!st.empty() && st.top() <= nums2[i]) {
                st.pop(); // Pop elements from the stack that are not greater
            }

            // If the stack is empty, it means there is no greater element
            if(st.empty()) {
                list[nums2[i]] = -1; // Assign -1 if no greater element exists
            } else {
                // The top element of the stack is the next greater element
                list[nums2[i]] = st.top();
            }
            // Push the current element onto the stack
            st.push(nums2[i]);
        }
        
        // Vector to store the results for nums1
        vector<int> ans;
        // For each element in nums1, retrieve the next greater element from the map
        for(int x : nums1) {
            ans.push_back(list[x]); // Add the next greater element to the result vector
        }
        return ans; // Return the result vector
    }
};
