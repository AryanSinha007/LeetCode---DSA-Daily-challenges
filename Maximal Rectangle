class Solution {
public:

    // Function to find the largest rectangle in a histogram
    int largestRectangleArea(vector<int>& heights) {

        int n = heights.size();

        // Monotonic increasing stack
        // Stores indices of histogram bars
        stack<int> st;

        int maxArea = 0;

        // Traverse all histogram bars
        for (int i = 0; i < n; i++) {

            // If current bar is smaller than stack top,
            // then stack top cannot extend further right.
            while (!st.empty() && heights[st.top()] > heights[i]) {

                // Bar whose area we are calculating
                int element = st.top();
                st.pop();

                // Next Smaller Element index
                int nse = i;

                // Previous Smaller Element index
                int pse = st.empty() ? -1 : st.top();

                // Width = nse - pse - 1
                int width = nse - pse - 1;

                // Area using current bar as minimum height
                int area = heights[element] * width;

                maxArea = max(maxArea, area);
            }

            // Push current index
            st.push(i);
        }

        // Process remaining elements in stack
        while (!st.empty()) {

            int element = st.top();
            st.pop();

            // No smaller element on right
            int nse = n;

            // Previous smaller element
            int pse = st.empty() ? -1 : st.top();

            int width = nse - pse - 1;

            int area = heights[element] * width;

            maxArea = max(maxArea, area);
        }

        return maxArea;
    }

    int maximalRectangle(vector<vector<char>>& matrix) {

        // Edge case
        if (matrix.empty())
            return 0;

        int n = matrix.size();      // rows
        int m = matrix[0].size();   // columns

        // Histogram heights for each column
        vector<int> heights(m, 0);

        int maxi = 0;

        // Process row by row
        for (int i = 0; i < n; i++) {

            // Build histogram for current row
            for (int j = 0; j < m; j++) {

                if (matrix[i][j] == '1')
                    heights[j] += 1;   // Extend height upward
                else
                    heights[j] = 0;    // Reset height
            }

            // Find largest rectangle in current histogram
            int area = largestRectangleArea(heights);

            maxi = max(maxi, area);
        }

        return maxi;
    }
};
