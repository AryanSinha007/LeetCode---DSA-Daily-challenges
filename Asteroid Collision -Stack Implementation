class Solution {
public:
    vector<int> asteroidCollision(vector<int>& asteroids) {
        stack<int> st;                    // Stack stores surviving asteroids
        int n = asteroids.size();

        for (int i = 0; i < n; i++) {

            // Positive asteroid: moving right
            // It cannot collide with previous negative asteroids,
            // so directly push it into the stack.
            if (asteroids[i] > 0) {
                st.push(asteroids[i]);
            } 
            else { // Negative asteroid: moving left

                // Collision is possible only when:
                // stack top is positive (moving right)
                // current asteroid is negative (moving left)
                //
                // If stack asteroid is smaller, it explodes.
                while (!st.empty() &&
                       st.top() > 0 &&
                       st.top() < abs(asteroids[i])) {
                    st.pop();
                }

                // After removing all smaller positive asteroids:

                // Case 1:
                // Equal sizes -> both explode
                if (!st.empty() &&
                    st.top() == abs(asteroids[i])) {
                    st.pop();
                }

                // Case 2:
                // No asteroid left to collide with OR
                // top is negative (same direction)
                // Current asteroid survives.
                else if (st.empty() || st.top() < 0) {
                    st.push(asteroids[i]);
                }

                // Case 3:
                // st.top() > abs(asteroids[i])
                // Positive asteroid is larger.
                // Current negative asteroid explodes.
                // Do nothing.
            }
        }

        // Convert stack to vector
        vector<int> ans(st.size());

        // Stack gives elements in reverse order,
        // so fill vector from back to front.
        for (int i = st.size() - 1; i >= 0; i--) {
            ans[i] = st.top();
            st.pop();
        }

        return ans;
    }
};
