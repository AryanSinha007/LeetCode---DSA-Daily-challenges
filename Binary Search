class Solution {
public:
    // Function to search for a target value in a sorted array
    int search(vector<int>& nums, int target) {
        // Get the size of the input array
        int n = nums.size();
        // Initialize pointers for the start (low) and end (high) of the search range
        int low = 0;
        int high = n - 1;

        // Loop until the search range is valid
        while (low <= high) {
            // Calculate the middle index of the current search range
            int mid = (low + high) / 2;

            // Check if the middle element is the target
            if (nums[mid] == target) {
                // If found, return the index of the target
                return mid;
            }
            // If the target is less than the middle element, search the left half
            else if (target < nums[mid]) {
                high = mid - 1; // Move the high pointer to mid - 1
            }
            // If the target is greater than the middle element, search the right half
            else {
                low = mid + 1; // Move the low pointer to mid + 1
            }
        }

        // If the target is not found, return -1
        return -1;
    }
};
