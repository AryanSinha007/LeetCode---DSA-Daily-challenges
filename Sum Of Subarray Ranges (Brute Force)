class Solution {
public:
    long long subArrayRanges(vector<int>& nums) {
        
        // Store the size of the array
        int n = nums.size();

        // This will store the final answer
        long long sum = 0;

        // Choose the starting index of each subarray
        for (int i = 0; i < n; i++) {

            // For every new starting point,
            // initialize largest and smallest
            // with the first element of the subarray
            int largest = nums[i];
            int smallest = nums[i];

            // Extend the subarray from i to j
            for (int j = i + 1; j < n; j++) {

                // Update maximum element seen so far
                largest = max(largest, nums[j]);

                // Update minimum element seen so far
                smallest = min(smallest, nums[j]);

                // Range of current subarray
                // = maximum element - minimum element
                sum += (long long)(largest - smallest);
            }
        }

        // Return total sum of ranges of all subarrays
        return sum;
    }
};
